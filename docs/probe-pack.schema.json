{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuvscan.dev/schemas/probe-pack-v1.json",
  "title": "Shuvscan probe pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "signer", "probes"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "signer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SHUV-[A-Z0-9]+-[0-9]{3}$"
      }
    }
  }
}
